            ".read": "auth != null",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "settings": {
            ".read": "auth != null",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "activities": {
            ".read": "auth != null",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "activities_summary": {
            ".read": "auth != null",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "activities_private": {
