                ".write": "auth != null && auth.uid == $odience",
                ".validate": "newData.hasChildren(['displayName']) && ((newData.hasChildren(['optionIndex', 'answeredAt', 'responseTime']) && !newData.hasChild('optionText') && !newData.hasChild('votedAt')) || newData.hasChildren(['text', 'answeredAt', 'responseTime']) || newData.hasChildren(['booleanValue', 'answeredAt', 'responseTime']) || newData.hasChildren(['scaleValue', 'answeredAt', 'responseTime']) || (newData.hasChildren(['action', 'joinedAt']) && newData.child('action').val() == 'join') || newData.hasChildren(['optionIndex', 'optionText', 'votedAt']) || (newData.hasChildren(['type', 'claimedAt']) && newData.child('type').val() == 'dance_claim') || (newData.hasChildren(['action', 'claimedAt']) && newData.child('action').val() == 'dance_claim'))",
                "displayName": {
                  ".validate": "newData.isString() && newData.val().length <= 80"
                },
                "optionIndex": {
                  ".validate": "newData.isNumber()"
                },
                "answeredAt": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "responseTime": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
                },
                "booleanValue": {
                  ".validate": "newData.isBoolean()"
                },
                "scaleValue": {
                  ".validate": "newData.isNumber()"
                },
                "action": {
                  ".validate": "newData.val() == 'join' || newData.val() == 'dance_claim'"
                },
                "joinedAt": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
