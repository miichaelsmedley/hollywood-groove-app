{
  "rules": {
    "test": {
      ".read": false,
      ".write": false,

      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt', 'lastSeenAt', 'showsAttended', 'preferences'])",
          "uid": {
            ".validate": "newData.val() == $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "email": {
            ".validate": "newData.isString()"
          },
          "phone": {
            ".validate": "newData.isString()"
          }
        },
        ".indexOn": ["displayName"]
      },

      "members": {
        ".read": "auth != null && auth.token.platform_admin == true",
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          ".write": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          "roles": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          },
          "role_assigned_by": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          },
          "role_assigned_at": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          }
        }
      },

      "shows": {
        ".read": "auth != null",
        "$showId": {
          "meta": {
            ".read": true,
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "settings": {
            ".read": "auth != null && auth.token.platform_admin == true",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "activities": {
            ".read": true,
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "activities_private": {
            ".read": "auth != null && auth.token.platform_admin == true",
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "live": {
            ".read": true,
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "attendees": {
            "$odience": {
              ".read": true,
              ".write": "auth != null && (auth.uid == $odience || auth.token.platform_admin == true)",
              "flags": {
                ".read": "auth != null && auth.token.platform_admin == true",
                ".write": "auth != null && auth.token.platform_admin == true"
              }
            }
          },
          "responses": {
            "$activityId": {
              "$odience": {
                ".read": true,
                ".write": "auth != null && auth.uid == $odience",
                ".validate": "newData.hasChildren() && (!newData.hasChild('displayName') || newData.child('displayName').isString())"
              }
            }
          },
          "results": {
            ".read": true,
            ".write": "false"
          },
          "scores": {
            ".read": true,
            ".indexOn": ["totalScore"],
            "$odience": {
              ".write": "false"
            }
          },
          "leaderboard": {
            ".read": true,
            ".write": "false"
          },
          "offers": {
            ".read": true,
            ".write": "auth != null && auth.token.platform_admin == true"
          },
          "offer_claims": {
            "$odience": {
              "$offerId": {
                ".read": "auth != null && auth.uid == $odience",
                ".write": "auth != null && auth.uid == $odience"
              }
            }
          }
        }
      },

      "seasons": {
        ".read": true,
        ".write": "auth != null && auth.token.platform_admin == true"
      },

      "between_show_trivia": {
        "$triviaId": {
          ".read": true,
          ".write": "auth != null && auth.token.platform_admin == true",
          "responses": {
            "$odience": {
              ".read": "auth != null && auth.uid == $odience",
              ".write": "auth != null && auth.uid == $odience"
            }
          }
        }
      },

      "trivia_library": {
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "categories": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "questions": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "activities": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "schedule": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "usage": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      },

      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "false"
        }
      },

      "controller": {
        "heartbeat": {
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['lastSeenAt', 'bundleID', 'platform']) && newData.child('lastSeenAt').isNumber() && newData.child('bundleID').isString() && newData.child('platform').isString()"
          }
        }
      },

      "teams": {
        ".read": "auth != null",
        ".indexOn": ["name", "code"],
        "$teamId": {
          ".write": "auth != null && (!data.exists() || data.child('created_by').val() == auth.uid || auth.token.platform_admin == true)",
          "members": {
            "$uid": {
              ".write": "auth != null && (auth.uid == $uid || data.parent().parent().child('created_by').val() == auth.uid || auth.token.platform_admin == true)"
            }
          }
        }
      },

      "team_codes": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.hasChildren(['team_id', 'created_by']) && newData.child('team_id').isString() && newData.child('created_by').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('test/teams').child(data.child('team_id').val()).child('created_by').val() == auth.uid))"
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt', 'lastSeenAt', 'showsAttended', 'preferences'])",
        "uid": {
          ".validate": "newData.val() == $uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "phone": {
          ".validate": "newData.isString()"
        }
      },
      ".indexOn": ["displayName"]
    },

    "members": {
      ".read": "auth != null && auth.token.platform_admin == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
        ".write": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
        "roles": {
          ".write": "auth != null && auth.token.platform_admin == true",
          ".validate": "auth != null && auth.token.platform_admin == true"
        },
        "role_assigned_by": {
          ".write": "auth != null && auth.token.platform_admin == true",
          ".validate": "auth != null && auth.token.platform_admin == true"
        },
        "role_assigned_at": {
          ".write": "auth != null && auth.token.platform_admin == true",
          ".validate": "auth != null && auth.token.platform_admin == true"
        }
      }
    },

    "shows": {
      ".read": "auth != null",
      "$showId": {
        "meta": {
          ".read": true,
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "settings": {
          ".read": "auth != null && auth.token.platform_admin == true",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "activities": {
          ".read": true,
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "activities_private": {
          ".read": "auth != null && auth.token.platform_admin == true",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "live": {
          ".read": true,
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "attendees": {
          "$odience": {
            ".read": true,
            ".write": "auth != null && (auth.uid == $odience || auth.token.platform_admin == true)",
            "flags": {
              ".read": "auth != null && auth.token.platform_admin == true",
              ".write": "auth != null && auth.token.platform_admin == true"
            }
          }
        },
        "responses": {
          "$activityId": {
            "$odience": {
              ".read": true,
              ".write": "auth != null && auth.uid == $odience",
              ".validate": "newData.hasChildren() && (!newData.hasChild('displayName') || newData.child('displayName').isString())"
            }
          }
        },
        "results": {
          ".read": true,
          ".write": "false"
        },
        "scores": {
          ".read": true,
          ".indexOn": ["totalScore"],
          "$odience": {
            ".write": "false"
          }
        },
        "leaderboard": {
          ".read": true,
          ".write": "false"
        },
        "offers": {
          ".read": true,
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "offer_claims": {
          "$odience": {
            "$offerId": {
              ".read": "auth != null && auth.uid == $odience",
              ".write": "auth != null && auth.uid == $odience"
            }
          }
        },
        "team_scores": {
          ".read": "auth != null",
          ".write": false
        },
        "team_leaderboard": {
          ".read": "auth != null",
          ".write": false
        }
      }
    },

    "seasons": {
      ".read": true,
      ".write": "auth != null && auth.token.platform_admin == true"
    },

    "between_show_trivia": {
      "$triviaId": {
        ".read": true,
        ".write": "auth != null && auth.token.platform_admin == true",
        "responses": {
          "$odience": {
            ".read": "auth != null && auth.uid == $odience",
            ".write": "auth != null && auth.uid == $odience"
          }
        }
      }
    },

    "trivia_library": {
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "categories": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "questions": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "activities": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "schedule": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "usage": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "controller": {
      "heartbeat": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['lastSeenAt', 'bundleID', 'platform']) && newData.child('lastSeenAt').isNumber() && newData.child('bundleID').isString() && newData.child('platform').isString()"
        }
      }
    },

    "teams": {
      ".read": "auth != null",
      ".indexOn": ["name", "code"],
      "$teamId": {
        ".write": "auth != null && (!data.exists() || data.child('created_by').val() == auth.uid || auth.token.platform_admin == true)",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || data.parent().parent().child('created_by').val() == auth.uid || auth.token.platform_admin == true)"
          }
        }
      }
    },

    "team_codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.hasChildren(['team_id', 'created_by']) && newData.child('team_id').isString() && newData.child('created_by').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('teams').child(data.child('team_id').val()).child('created_by').val() == auth.uid))"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "false"
      }
    },

    "testers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "false"
      }
    },

    "audit_log": {
      ".read": "auth != null && auth.token.platform_admin == true",
      ".write": "false",
      ".indexOn": ["action", "actorUid", "at", "targetUid"]
    }
  }
}
