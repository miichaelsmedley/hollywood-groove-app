                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "type": {
                  ".validate": "newData.val() == 'dance_claim'"
                },
                "claimedAt": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
