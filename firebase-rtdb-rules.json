              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "dance_window_awards": {
          "$windowId": {
            "$uid": {
              ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
              ".write": "false"
            }
          }
        },
        "dance_window_control": {
          ".read": "auth != null && auth.token.platform_admin == true",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "results": {
          ".read": "auth != null",
          ".write": "false"
        },
        "scores": {
          ".read": "auth != null",
          ".indexOn": ["totalScore"],
          "$odience": {
            ".write": "false"
          }
        },
        "leaderboard": {
          ".read": "auth != null",
          ".write": "false"
        },
        "set_scores": {
          ".read": "auth != null",
          ".write": "false",
          "$setNumber": {
            ".indexOn": ["totalScore"]
          }
        },
        "set_leaderboards": {
          ".read": "auth != null",
          ".write": "false"
        },
        "set_winners": {
          ".read": "auth != null",
          ".write": "false"
        },
        "night_winner": {
          ".read": "auth != null",
          ".write": "false"
        },
        "set_closures": {
          ".read": "auth != null && auth.token.platform_admin == true",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "show_closures": {
          ".read": "auth != null && auth.token.platform_admin == true",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "offers": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.platform_admin == true"
        },
        "offer_awards": {
          "$odience": {
            ".read": "auth != null && (auth.uid == $odience || auth.token.platform_admin == true)",
            "$offerId": {
              ".write": "false"
            }
          }
        },
        "offer_claims": {
          ".read": "auth != null && auth.token.platform_admin == true",
          "$odience": {
            "$offerId": {
              ".read": "auth != null && (auth.uid == $odience || auth.token.platform_admin == true)",
              ".write": "false"
            }
          }
        },
        "team_scores": {
          ".read": "auth != null",
          ".write": false
        },
        "team_leaderboard": {
          ".read": "auth != null",
          ".write": false
        }
      }
    },

    "seasons": {
      ".read": true,
      ".write": "auth != null && auth.token.platform_admin == true"
    },

    "config": {
      "current_season": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
      }
    },

    "leaderboards": {
      "season": {
        "$seasonId": {
          ".read": "auth != null",
          ".write": "false"
        }
      }
    },

    "offer_claims_by_uid": {
      "$odience": {
        ".read": "auth != null && (auth.uid == $odience || auth.token.platform_admin == true)",
        "$claimId": {
          ".write": "false"
        }
      }
    },

    "between_show_trivia": {
      "$triviaId": {
        ".read": true,
        ".write": "auth != null && auth.token.platform_admin == true",
        "responses": {
          "$odience": {
            ".read": "auth != null && auth.uid == $odience",
            ".write": "auth != null && auth.uid == $odience"
          }
        }
      }
    },

    "trivia_library": {
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "categories": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "questions": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "activities": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "schedule": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true"
      },
      "usage": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "controller": {
      "heartbeat": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['lastSeenAt', 'bundleID', 'platform']) && newData.child('lastSeenAt').isNumber() && newData.child('bundleID').isString() && newData.child('platform').isString()"
        }
      }
    },

    "teams": {
      ".read": "auth != null",
      ".indexOn": ["name", "code"],
      "$teamId": {
        ".write": "auth != null && (!data.exists() || data.child('created_by').val() == auth.uid || auth.token.platform_admin == true)",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || data.parent().parent().child('created_by').val() == auth.uid || auth.token.platform_admin == true)"
          }
        }
      }
    },

    "team_codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.hasChildren(['team_id', 'created_by']) && newData.child('team_id').isString() && newData.child('created_by').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('teams').child(data.child('team_id').val()).child('created_by').val() == auth.uid))"
      }
    },

    "team_names": {
      ".read": "auth != null",
      "$nameKey": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.hasChildren(['team_id', 'created_by']) && newData.child('team_id').isString() && newData.child('created_by').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('teams').child(data.child('team_id').val()).child('created_by').val() == auth.uid))"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "false"
      }
    },

    "testers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "false"
      }
    },

    "audit_log": {
      ".read": "auth != null && auth.token.platform_admin == true",
      ".write": "false",
      ".indexOn": ["action", "actorUid", "at", "targetUid"]
    }
  }
}
