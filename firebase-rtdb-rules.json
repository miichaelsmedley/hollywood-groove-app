{
  "rules": {
    "test": {
      ".read": false,
      ".write": false,

      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt', 'lastSeenAt', 'showsAttended', 'preferences'])",
          "uid": {
            ".validate": "newData.val() == $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
          },
          "email": {
            ".validate": "newData.isString()"
          },
          "phone": {
            ".validate": "newData.isString()"
          }
        },
        ".indexOn": ["displayName"]
      },

      "members": {
        ".read": "auth != null && auth.token.platform_admin == true",
        ".indexOn": ["display_name"],
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          ".write": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true)",
          "current_team": {
            ".write": "auth != null && (auth.uid == $uid || auth.token.platform_admin == true || (data.exists() && data.child('team_id').isString() && root.child('test/teams').child(data.child('team_id').val()).child('created_by').val() == auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['team_id', 'team_name', 'joined_at', 'role']) && newData.child('team_id').isString() && newData.child('team_id').val().length > 0 && newData.child('team_id').val().length <= 128 && newData.child('team_name').isString() && newData.child('team_name').val().length > 0 && newData.child('team_name').val().length <= 30 && newData.child('joined_at').isNumber() && (newData.child('role').val() == 'owner' || newData.child('role').val() == 'member'))",
            "team_id": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "team_name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "joined_at": {
              ".validate": "newData.isNumber()"
            },
            "role": {
              ".validate": "newData.val() == 'owner' || newData.val() == 'member'"
            }
          },
          "roles": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          },
          "role_assigned_by": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          },
          "role_assigned_at": {
            ".write": "auth != null && auth.token.platform_admin == true",
            ".validate": "auth != null && auth.token.platform_admin == true"
          },
          "season_points": {
            ".validate": false
          },
          "season_points_awards": {
            ".validate": false
          }
        }
      },

      "shows_index": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.platform_admin == true",
        ".indexOn": ["startDate", "status", "isTestShow", "is_test", "test"]
      },

