rules_version = '2';

// Firebase Storage rules for Hollywood Groove rich media moments.
//
// Moment assets (image/video/audio/pre-rendered map images) are uploaded by the
// controller and referenced by download URL in shows/{showId}/live/moment. Song-
// authored assets live under show-media/songs/{songId}/..., while future
// show-specific assets can live under show-media/shows/{showId}/.... They must
// be publicly readable (attendee phones + stage TV) but writable only by a
// platform admin — matching the RTDB security model (auth.token.platform_admin).
service firebase.storage {
  match /b/{bucket}/o {
    // Production media: show-media/{scope}/{id}/...
    match /show-media/{scope}/{id}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.platform_admin == true
                   && request.resource.size < 100 * 1024 * 1024;
    }

    // Test-mode media mirror: test/show-media/{scope}/{id}/...
    match /test/show-media/{scope}/{id}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.platform_admin == true
                   && request.resource.size < 100 * 1024 * 1024;
    }

    // Everything else is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
